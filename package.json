{
  "name": "finance-control-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-tauri.ps1 dev",
    "desktop:build:no-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-tauri.ps1 build --no-bundle",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-desktop.ps1",
    "desktop:dev:integrated": "npm run desktop:prepare && npm run desktop:dev",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-desktop.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
